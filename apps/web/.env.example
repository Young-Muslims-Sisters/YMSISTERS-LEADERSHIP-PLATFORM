# Copy to .env.local (hosted) or .env.development.local (local stack) and fill in.
# Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Which annual cycle the public form collects.
FORM_CYCLE_YEAR=2027

# Email delivery (SRC notifications).
#   mailpit = local Supabase inbox (development)
#   console = print to the server log
#   smtp    = real provider (e.g. Google Workspace); configure before production
EMAIL_TRANSPORT=console
MAILPIT_URL=http://127.0.0.1:54424
EMAIL_FROM="YM Sisters Leadership <no-reply@example.org>"
